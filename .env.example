# Copy to .env and fill in. `.env` is gitignored.
#
# pretrain.py auto-loads <repo>/.env at startup via util.env.load_dotenv().
# Variables already exported in your shell take precedence over .env values,
# so you can still do `WANDB_MODE=offline uv run bash scripts/pretrain.sh ...`
# for one-off overrides.

# --- Weights & Biases ---
# Required when `wandb: true` in your config (the default). The configs resolve
# these via ${oc.env:WANDB_ENTITY,???} so a missing WANDB_ENTITY fails loudly
# at startup instead of silently logging to the wrong team.
WANDB_ENTITY=your-wandb-entity
# WANDB_PROJECT=mixture-of-recursions-vision   # default; uncomment to override
# WANDB_MODE=online                            # "offline" to skip network

# --- Data ---
# Root of the extracted CLEVR archive (contains train/, val/, ...).
# Defaults to <repo>/data/clevr_dataset if unset (see lm_dataset/load_dataset.py).
# CLEVR_ROOT=/absolute/path/to/clevr_dataset
# Root of the tokenized TerraMesh val split: contains <MOD>_tok224/ and
# tok_index.parquet. Used by dataset: terramesh_multimodal.
# TERRAMESH_TOK_ROOT=/data/enric/data/TerraMesh/val

# --- Models ---
# Path to the Cosmos DI-16×16 tokenizer checkpoint directory.
# Defaults to pretrained_ckpts/Cosmos-0.1-Tokenizer-DI16x16 (relative to repo root).
# COSMOS_TOKENIZER_PATH=pretrained_ckpts/Cosmos-0.1-Tokenizer-DI16x16

# --- Caches & output dirs (all optional, sensible defaults under <repo>/) ---
# HF_HOME=./hf_cache
# MOR_SAVE_DIR=./results
# MOR_DATA_DIR=./hf_datasets
# MOR_MODEL_DIR=./hf_models

# --- Hugging Face Hub ---
# pretrain.py loads two text tokenizers at import (util/tokenizer.py), and unless
# WANDB_MODE is offline it asks the Hub for them on every launch. Once they are in
# HF_HOME's cache, offline mode makes a launch independent of the network and of
# any token. Put HF_HUB_OFFLINE=0 in the shell for anything that must download.
# HF_HUB_OFFLINE=1
